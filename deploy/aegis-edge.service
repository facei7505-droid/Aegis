# Without Docker: Caddy from the distribution package, Aegis as a service.
#   sudo pip install "aegis-selfheal[edge]"   (or from a clone: pip install ".[edge]")
#   sudo useradd --system --home /var/lib/aegis aegis && sudo mkdir -p /var/lib/aegis && sudo chown aegis /var/lib/aegis
#   sudo cp deploy/aegis-edge.service /etc/systemd/system/ && sudo systemctl enable --now aegis-edge
#   aegis edge caddyfile --email you@example.kz --aegis 127.0.0.1:8080 | sudo tee /etc/caddy/Caddyfile
[Unit]
Description=Aegis Edge (protection for client sites)
After=network-online.target
Wants=network-online.target

[Service]
User=aegis
Environment=AEGIS_HOME=/var/lib/aegis
ExecStart=/usr/local/bin/aegis edge serve --host 127.0.0.1 --port 8080
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aegis
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
